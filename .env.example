# ── classification: local open-weight TabPFN (Prior Labs tabular foundation model) ──
# Runs on-device. Token lifts any Prior Labs usage limits; optional for the local path.
TABPFN_TOKEN=

# ── narration: 0G Compute decentralized open-weight LLM (the live narrator) ──
# deepseek-v4.1-flash served over the 0G decentralized compute network (open weights).
LLM_BASE_URL=https://router-api.0g.ai/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=
ZERO_G_COMPUTE_API_KEY=

# ── narration fallback: local Gemma via Ollama (keyless, co-located) ──
# Swap LLM_BASE_URL/LLM_MODEL/LLM_API_KEY to use it:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=gemma2:2b
#   LLM_API_KEY=ollama
# ── narration fallback: Groq (hosted, needs a key) ──
GROQ_API_KEY=

# optional: lifts the GitHub unauthenticated rate limit 60/hr -> 5000/hr
GITHUB_TOKEN=

# feature extraction + seed
COMMIT_WINDOW=1000
SEED_PATH=data/seed_repos.csv

# cached example repos (famous archived/dead projects)
EX_ABANDONED=bower/bower
EX_BURNED=sindresorhus/caprine
EX_ALIVE=fastapi/fastapi
